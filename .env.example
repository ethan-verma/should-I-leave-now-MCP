# Google Maps Platform key with these APIs enabled:
# Routes API, Geocoding API, Time Zone API, Weather API, Air Quality API, Places API (New)
GOOGLE_MAPS_API_KEY=your-key-here
# Requests per minute allowed per client IP
RATE_LIMIT_PER_MINUTE=60

# Optional sign-in and saved places (leave unset to run with no accounts)
# AUTHKIT_DOMAIN=your-subdomain.authkit.app
# WORKOS_API_KEY=sk_...            # only used to look up a signed-in user's email
# FIRESTORE_CREDENTIALS_JSON={...}  # service account key JSON, on one line
# PUBLIC_URL=https://should-i-leave-now.onrender.com/mcp
# BATON_USERS=you@example.com,friend@example.com  # signed-in users Baton should name
